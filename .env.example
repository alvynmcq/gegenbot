# ==========================================
# Autonomous FPL Engine Configuration
# ==========================================

# --- FPL Authentication & Credentials ---
# FPL Team ID (found in URL when viewing your points/transfers: https://fantasy.premierleague.com/entry/{TEAM_ID}/event/...)
FPL_TEAM_ID=1234567

# Optional: FPL account login
FPL_EMAIL=your_email@example.com
FPL_PASSWORD=your_password

# Authentication bearer token and PingOne OAuth2 refresh token for FPL API
# Used for X-API-Authorization and Authorization Bearer headers
FPL_AUTH_TOKEN=
FPL_ACCESS_TOKEN=
FPL_REFRESH_TOKEN=

# Mini-League ID to track rival picks, effective ownership (EO), and threat matrix
LEAGUE_ID=123456

# --- External Data & Projections (FPL Core Insights & Vaastav) ---
# Automated ingestion from open-source GitHub dataset (olbauday/FPL-Core-Insights)
# Default remote URL: https://raw.githubusercontent.com/olbauday/FPL-Core-Insights/main/data/2026-2027/playerstats.csv
# Default local paths: data/playerstats.csv or data/fpl_core_insights.csv
FPL_CORE_INSIGHTS_URL=
FPL_CORE_INSIGHTS_CSV_PATH=

# Historical match logs & underlying stats (xGI/90, xGC/90) from vaastav/Fantasy-Premier-League
VAASTAV_DATA_ENABLED=true
VAASTAV_SEASON=2026-27
VAASTAV_DATA_URL=https://raw.githubusercontent.com/vaastav/Fantasy-Premier-League/master/data/2026-27

# --- Mathematical Solver Configuration ---
DECAY_FACTOR=0.85                # Multi-Gameweek Horizon Decay Factor (gamma)
HORIZON_LENGTH=3                 # Number of future Gameweeks in lookahead horizon (1 to 5)
BENCH_WEIGHT_FACTOR=0.10         # Expected auto-sub utility weight for bench players (sub factor)
HIT_MIN_NET_XP_GAIN=5.0          # Minimum net decayed xP gain required to justify taking a -4 hit
ROLLING_BONUS_XP=1.5             # Strategic valuation for rolling/banking a Free Transfer

# --- Telegram Alert Dispatcher ---
# Create a bot via @BotFather on Telegram and get your Bot Token
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Your personal or group chat ID (use @userinfobot or /getUpdates to find it)
TELEGRAM_CHAT_ID=123456789

# --- AI Decision Director (LLM) ---
# Any OpenAI-compatible API endpoint (OpenAI, DeepSeek, Local Ollama, Groq, OpenRouter)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Live Press Conference & News Grounding ---
ENABLE_LIVE_NEWS=true
# Optional: Dedicated search API key (Tavily). Falls back to free search / FPL API feeds if blank.
TAVILY_API_KEY=

# --- Web Dashboard ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
